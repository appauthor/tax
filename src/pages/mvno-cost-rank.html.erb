                    <div class="form-group"><label for="practical-offer-2">할인 중 월 요금 (원)</label><input id="practical-offer-2" name="offer" type="text" class="money-input" inputmode="numeric" value="9,900" required></div>
                    <div class="form-group"><label for="practical-regular-2">할인 종료 후 월 요금 (원)</label><input id="practical-regular-2" name="regular" type="text" class="money-input" inputmode="numeric" value="9,900" required></div>
