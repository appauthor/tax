                    <div class="form-group"><label for="practical-months-1">할인 적용 개월 수</label><input id="practical-months-1" name="months" type="number" value="7" min="0" max="36" step="1" required></div>
                    <div class="form-group"><label for="practical-oneTime-1">유심비 등 일회성 비용 (원)</label><input id="practical-oneTime-1" name="oneTime" type="text" class="money-input" inputmode="numeric" value="7,700" required></div>
