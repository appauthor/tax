<section class="calculator-section active" aria-labelledby="salaryRankCalculatorTitle">
        <h2 id="salaryRankCalculatorTitle">연봉 순위·지역 평균 비교</h2>
        <form id="salaryRankForm">
            <div class="tax-form-card form-grid">
